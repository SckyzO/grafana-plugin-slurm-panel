{
  "name": "slurm-views",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && pnpm --filter tomzone-slurm-panel lint",
    "format": "pnpm --filter tomzone-slurm-panel format",
    "format:check": "pnpm --filter tomzone-slurm-panel format:check",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter tomzone-slurm-panel e2e"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.72.1"
  }
}
