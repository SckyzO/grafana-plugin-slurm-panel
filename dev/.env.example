# Bump these deliberately, and say so in the commit. GRAFANA_IMAGE carries the
# image NAME only — `grafana` or `grafana-enterprise`; the compose file adds
# the `grafana/` prefix itself, the same way `grafana/plugin-actions` supplies
# it to CI.
GRAFANA_IMAGE=grafana
GRAFANA_VERSION=13.2.2

# Where the stack publishes itself on the host. The defaults are the ports a
# Grafana and a Prometheus are normally found on; change them here when the
# machine already runs one of either — nothing inside the compose network
# moves, so only a host browser notices.
GRAFANA_PORT=3000
PROM_PORT=9090

# Cluster size. Set SYNTH_NODES for the total, or SYNTH_RACKS with
# SYNTH_NODES_PER_RACK for their product (4 racks of 80); SYNTH_RACKS does
# nothing on its own. Node names are flat, c1.. and g1.., and carry no rack,
# like the real exporter's. The families and their partitions are fixed in
# dev/synthetic-exporter/serve.py. 3000 nodes is the realistic ceiling for a
# single panel.
# SYNTH_RACKS=9
SYNTH_NODES_PER_RACK=0
# SYNTH_NODES=540

# The seed that fixes which node lands in which state. The same seed gives the
# same cluster every time, so a screenshot or a failing e2e run can be
# reproduced exactly.
SYNTH_SEED=1

# The shape of the state distribution, independent of node count:
# production (default) is a cluster that is working, incident is the same
# shape with one rack down and a drain storm, showcase draws every state the
# panel can paint, idle and mixed weighted up.
SYNTH_PROFILE=production
