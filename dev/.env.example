# Bump these deliberately, and say so in the commit. GRAFANA_IMAGE carries the
# image NAME only — `grafana` or `grafana-enterprise`; the compose file adds
# the `grafana/` prefix itself, the same way `grafana/plugin-actions` supplies
# it to CI.
GRAFANA_IMAGE=grafana
GRAFANA_VERSION=13.2.1

# Cluster shape. Set SYNTH_NODES_PER_RACK when the rack is what you are
# shaping (4 racks of 80), or leave it at 0 and set SYNTH_NODES when the total
# is (3000 spread over 75). Both give exactly SYNTH_RACKS racks.
# 3000 nodes is the realistic ceiling for a single panel.
SYNTH_RACKS=6
SYNTH_NODES_PER_RACK=0
SYNTH_NODES=240

# Partition names, and the seed that fixes which node lands in which state.
# The same seed gives the same cluster every time, so a screenshot or a
# failing e2e run can be reproduced exactly.
SYNTH_PARTITIONS=cpu,gpu,debug
SYNTH_SEED=1

# The shape of the state distribution, independent of node count:
# production (default) is a cluster that is working, incident is the same
# shape with one rack down and a drain storm, showcase is a uniform spread
# over every state the panel can paint.
SYNTH_PROFILE=production
