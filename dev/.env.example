# Bump these deliberately, and say so in the commit.
GRAFANA_IMAGE=grafana/grafana
GRAFANA_VERSION=13.2.1

# Cluster shape. Set SYNTH_NODES_PER_RACK when the rack is what you are
# shaping (4 racks of 80), or leave it at 0 and set SYNTH_NODES when the total
# is (3000 spread over 75). Both give exactly SYNTH_RACKS racks.
# 3000 nodes is the realistic ceiling for a single panel.
SYNTH_RACKS=6
SYNTH_NODES_PER_RACK=0
SYNTH_NODES=240

# Partition names, and the seed that fixes which node lands in which state.
# The same seed gives the same cluster every time, so a screenshot or a
# failing e2e run can be reproduced exactly.
SYNTH_PARTITIONS=cpu,gpu,debug
SYNTH_SEED=1
