{
  "uid": "slurm-node-grid",
  "title": "Slurm node grid",
  "tags": [
    "slurm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "tomzone-slurm-panel",
      "title": "Nodes, grouped by rack",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_node_status",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "slurm_node_cpu_alloc",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "slurm_node_cpu_total",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "slurm_node_gres_used",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "slurm_node_gres_total",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "slurm_node_drain_reason_info",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "time() - slurm_node_drain_since_timestamp_seconds",
          "instant": true
        }
      ],
      "options": {
        "labels": {
          "node": "node",
          "state": "status",
          "partition": "partition",
          "gresType": "gres_type",
          "reason": "reason"
        },
        "slots": {
          "state": "A",
          "cpuAlloc": "B",
          "cpuTotal": "C",
          "gresUsed": "D",
          "gresTotal": "E",
          "drainReason": "F",
          "drainSince": "G"
        },
        "grouping": {
          "kind": "label",
          "label": "rack"
        },
        "multiValueLabel": false,
        "layout": "rack",
        "cellWidth": 14,
        "gap": 2,
        "shapeChannel": false,
        "colorMode": "state"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "slurm_exporter publishes node, status and partition, and nothing that describes where a node sits: it reads sinfo, and sinfo has no concept of a rack. This dashboard's rack label does not come from the exporter or from the node name \u2014 dev/relabel/racks.txt is turned into Prometheus relabelling by make scrape, and Grouping > Group by > Label reads that label directly. Point this panel at a Prometheus without that relabelling and there is no rack label to read; the fallback is then a capture on the node name, a join against an inventory, or a range table."
    }
  ]
}
