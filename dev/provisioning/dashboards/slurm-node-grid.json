{
  "uid": "slurm-node-grid",
  "title": "Slurm node grid",
  "tags": [
    "slurm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "tomzone-slurmnodegrid-panel",
      "title": "Nodes, grouped by the rack in their name",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_node_status",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "slurm_node_cpu_alloc",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "slurm_node_cpu_total",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "slurm_node_gres_used",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "slurm_node_gres_total",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "slurm_node_drain_reason_info",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "time() - slurm_node_drain_since_timestamp_seconds",
          "instant": true
        }
      ],
      "options": {
        "labels": {
          "node": "node",
          "state": "status",
          "partition": "partition",
          "gresType": "gres_type",
          "reason": "reason"
        },
        "slots": {
          "state": "A",
          "cpuAlloc": "B",
          "cpuTotal": "C",
          "gresUsed": "D",
          "gresTotal": "E",
          "drainReason": "F",
          "drainSince": "G"
        },
        "grouping": {
          "kind": "capture",
          "pattern": "^(r\\d+)"
        },
        "multiValueLabel": false,
        "layout": "rack",
        "cellWidth": 14,
        "gap": 2,
        "shapeChannel": false,
        "colorMode": "state"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "slurm_exporter publishes node, status and partition, and nothing else that describes where a node sits: it reads sinfo, and sinfo has no concept of a rack. The only structure available is the one encoded in the node name, so the grouping is a capture \u2014 '^(r\\\\d+)' here, '^([a-z]+)' on a cluster named c1..c10 / g1..g10. Grouping by a label works only if you put that label there yourself, through Prometheus relabelling or an inventory join."
    }
  ]
}
