          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
