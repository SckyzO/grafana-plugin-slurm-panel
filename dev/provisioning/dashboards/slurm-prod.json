      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 11,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "semi-dark-green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
