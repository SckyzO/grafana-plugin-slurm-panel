{
  "uid": "slurm-prod",
  "title": "Production",
  "tags": [
    "slurm",
    "production"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "What a production floor looks like on an ordinary day: the number you check first, the states underneath it, the two resources that actually run out, and the floor itself. Every count goes through `count by (node)` before it is counted, because slurm_exporter publishes one series per node and partition and a node in three partitions is still one node.",
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "In use",
      "description": "Nodes running work -- allocated or mixed, and still answering -- over all nodes. Deliberately not the same question as CPU allocated below: a cluster can have every node busy and half its cores idle, and the gap between the two is where the waste is.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto",
        "shape": "gauge",
        "barShape": "flat",
        "sparkline": false,
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(count by (node) (slurm_node_status{status=~\"alloc.*|mix.*\",status!~\".*[*~]\"})) or vector(0)) / (count(count by (node) (slurm_node_status))) * 100",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes",
      "description": "Distinct nodes, not series. `count by (node)` first, then count that.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status))",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Allocated",
      "description": "Nodes running work. A node whose state carries the `*` suffix has stopped answering whatever it was doing, and is left out here because the floor beside it paints that node orange rather than this tile's colour.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 7,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"alloc.*\",status!~\".*[*~]\"})) or vector(0)",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
