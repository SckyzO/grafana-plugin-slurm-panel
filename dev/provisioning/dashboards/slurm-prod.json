        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Unavailable nodes",
      "description": "Nodes no job can land on, whatever the reason: drained, draining, down, failed, unknown, invalid, reserved, under maintenance, or not answering. The maintenance backlog in one number, and the exact complement of Serviceable.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"drain.*|drng.*|down.*|fail.*|unk.*|inval.*|maint.*|resv.*|.*[*]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
