{
  "uid": "slurm-prod",
  "title": "Production example",
  "tags": [
    "slurm",
    "production"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "What a production floor looks like on an ordinary day: the number you check first, the states underneath it, the two resources that actually run out, and the floor itself. Every count goes through `count by (node)` before it is counted, because slurm_exporter publishes one series per node and partition and a node in three partitions is still one node.",
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Node availability",
      "description": "Share of the cluster a job could land on: everything minus the nodes drained, down, failed, unknown, invalid, reserved, under maintenance or not answering. The gauge beside it says how much of the cluster is working; this one says how much of it still could. The gap between them is the maintenance backlog - a cluster at 100% use over 60% serviceable is a cluster in trouble, and no single number says so.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - ((count(count by (node) (slurm_node_status{status=~\"drain.*|drng.*|down.*|fail.*|unk.*|inval.*|maint.*|resv.*|.*[*]\"})) or vector(0)) / (count(count by (node) (slurm_node_status))))) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto",
        "barShape": "flat",
        "barWidthFactor": 0.6,
        "effects": {
          "barGlow": false,
          "centerGlow": false,
          "gradient": true
        },
        "endpointMarker": "point",
        "orientation": "auto",
        "segmentCount": 1,
        "segmentSpacing": 0.3,
        "shape": "gauge",
        "sparkline": true,
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 85,
                "color": "orange"
              },
              {
                "value": 92,
                "color": "yellow"
              },
              {
                "value": 97,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Cluster utilisation",
      "description": "Share of the nodes carrying work, allocated and mixed together. Green at the top, not red: on an HPC cluster a busy machine is the point and an idle one is capacity earning nothing. Every utilisation scale on this dashboard reads the same way.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((count(count by (node) (slurm_node_status{status=~\"alloc.*|mix.*\",status!~\".*[*~]\"})) or vector(0)) / (count(count by (node) (slurm_node_status)))) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto",
        "barShape": "flat",
        "barWidthFactor": 0.6,
        "effects": {
          "barGlow": false,
          "centerGlow": false,
          "gradient": true
        },
        "endpointMarker": "point",
        "orientation": "auto",
        "segmentCount": 1,
        "segmentSpacing": 0.3,
        "shape": "gauge",
        "sparkline": true,
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 40,
                "color": "orange"
              },
              {
                "value": 60,
                "color": "yellow"
              },
              {
                "value": 80,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total nodes",
      "description": "Distinct nodes, not series. slurm_exporter publishes one series per (node, partition), so a node in three partitions is three series and one node - which is the count a stat panel over the raw metric gets wrong, and the reason this one counts by node first.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status))",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes running jobs",
      "description": "Nodes carrying work: allocated and mixed. Slurm keeps the two apart because ALLOCATED means every CPU is taken while MIXED means only some are, and a node is one or the other, never both. Both are nodes with jobs on them, so counting only ALLOCATED under-reports what the cluster is doing. The degree is in the floor plan's colours below.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 11,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"alloc.*|mix.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Idle nodes",
      "description": "Nodes with no work and nothing wrong: capacity available right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"idle.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Unavailable nodes",
      "description": "Nodes no job can land on, whatever the reason: drained, draining, down, failed, unknown, invalid, reserved, under maintenance, or not answering. The maintenance backlog in one number, and the exact complement of Serviceable.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"drain.*|drng.*|down.*|fail.*|unk.*|inval.*|maint.*|resv.*|.*[*]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Nodes down",
      "description": "Down, failed or unknown - the part of Unavailable nobody chose. Drained is a decision; down is a fault. Grey at zero so the tile only lights up when there is something to look at.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"down.*|fail.*|unk.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Node state over time",
      "description": "The question a snapshot cannot answer: is it getting worse? Stacked, so the top of the stack is the cluster and each band is a state - a drain storm shows as purple eating green, and a recovery shows as the same in reverse. Reading the tiles above alone, a backlog that doubled this morning and one that has been flat for a month look identical.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"alloc.*|mix.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Working"
        },
        {
          "refId": "B",
          "expr": "count(count by (node) (slurm_node_status{status=~\"idle.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Idle"
        },
        {
          "refId": "C",
          "expr": "count(count by (node) (slurm_node_status{status=~\"drain.*|drng.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Drained"
        },
        {
          "refId": "D",
          "expr": "count(count by (node) (slurm_node_status{status=~\"down.*|fail.*|unk.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Down"
        }
      ],
      "options": {
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Working"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Idle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Drained"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Down"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Unavailable CPU cores",
      "description": "sinfo reports a node's cores as allocated, idle or other, and other is the ones that exist and cannot be given to a job - the cores sitting inside a drained or down node. Counting nodes says twenty-seven are out; this says what that costs, and a drained bigmem node costs far more than a drained visu one.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(slurm_node_cpu_other)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Cores held out"
        }
      ],
      "options": {
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "tomzone-slurm-panel",
      "title": "Nodes by rack",
      "description": "The floor: nine cabinets against live Prometheus, each drawn as many sleds wide as its blade holds - four for the cpu racks, three for bigmem, two for gpu, one for visu - and twenty slots tall, which is what makes them level and full. The rack label comes from Prometheus relabelling at scrape time, the first of the three routes to a topology and the only one that needs no per-dashboard configuration. Hover a node for its state, its cores, its GPUs and, when it is drained, the reason and how long it has been out.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "labels": {
          "node": "node",
          "state": "status",
          "partition": "partition",
          "gresType": "gres_type",
          "reason": "reason"
        },
        "queries": {
          "state": "A",
          "cpuAlloc": "B",
          "cpuTotal": "C",
          "gresUsed": "D",
          "gresTotal": "E",
          "drainReason": "F",
          "drainSince": "G"
        },
        "grouping": {
          "kind": "label",
          "label": "rack"
        },
        "layout": "rack",
        "cellWidth": 28,
        "bladeOverrides": "cpu[1-4]: 4\nbigmem[1-2]: 3\nvisu1: 1\ngpu[1-2]: 2",
        "slotsPerRack": 20,
        "centreRacks": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_node_status",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "slurm_node_cpu_alloc",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "slurm_node_cpu_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "slurm_node_gres_used",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "slurm_node_gres_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "slurm_node_drain_reason_info",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "time() - slurm_node_drain_since_timestamp_seconds",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "CPU allocation by partition",
      "description": "One bar per partition rather than one number for the cluster: a floor at 63% can be a bigmem tier at 94% with nowhere left to put a large job, next to a visu tier nobody is using. The single figure hides exactly the thing worth acting on.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (partition) (slurm_node_cpu_alloc{partition=~\"cpu|bigmem|visu|gpu\"}) / sum by (partition) (slurm_node_cpu_total{partition=~\"cpu|bigmem|visu|gpu\"}) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true,
          "legendFormat": "{{partition}}"
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "sizing": "auto",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 22
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
