    {
      "id": 12,
      "type": "bargauge",
      "title": "Memory allocation by partition",
      "description": "Memory allocated over memory total, per partition. Jobs are rarely balanced, so this and the CPU bars differ.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
