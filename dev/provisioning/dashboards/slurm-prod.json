              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Node state over time",
      "description": "The question a snapshot cannot answer: is it getting worse? Stacked, so the top of the stack is the cluster and each band is a state - a drain storm shows as purple eating green, and a recovery shows as the same in reverse. Reading the tiles above alone, a backlog that doubled this morning and one that has been flat for a month look identical.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"alloc.*|mix.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Working"
        },
        {
          "refId": "B",
          "expr": "count(count by (node) (slurm_node_status{status=~\"idle.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Idle"
        },
        {
          "refId": "C",
          "expr": "count(count by (node) (slurm_node_status{status=~\"drain.*|drng.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Drained"
        },
        {
          "refId": "D",
          "expr": "count(count by (node) (slurm_node_status{status=~\"down.*|fail.*|unk.*\",status!~\".*[*~]\"})) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Down"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Working"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Idle"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Drained"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Down"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Unavailable CPU cores",
      "description": "sinfo reports a node's cores as allocated, idle or other, and other is the ones that exist and cannot be given to a job - the cores sitting inside a drained or down node. Counting nodes says twenty-seven are out; this says what that costs, and a drained bigmem node costs far more than a drained visu one.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(slurm_node_cpu_other)",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "range": true,
          "legendFormat": "Cores held out"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "tomzone-slurm-panel",
      "title": "Nodes by rack",
      "description": "Six cabinets against live Prometheus, two nodes to a blade, each declared at twenty-one slots so the floor is flat and every cabinet keeps one free position visible above its contents. The rack label comes from Prometheus relabelling at scrape time, the first of the three routes to a topology and the only one that needs no per-dashboard configuration. Hover a node for its state, its cores, its GPUs and, when it is drained, the reason and how long it has been out. Fourteen pixels a cell, measured rather than chosen: at this panel's half width and height, nine cabinets fit on one line up to 14 and wrap to two from 16 - seven of the nine are floored by the width of their own header, not by their cells. Give the panel the full width and it carries a far larger cell on one line.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "labels": {
          "node": "node",
          "state": "status",
          "partition": "partition",
          "gresType": "gres_type",
          "reason": "reason"
        },
        "queries": {
          "state": "A",
          "cpuAlloc": "B",
          "cpuTotal": "C",
          "gresUsed": "D",
          "gresTotal": "E",
          "drainReason": "F",
          "drainSince": "G"
        },
        "grouping": {
          "kind": "label",
          "label": "rack"
        },
        "multiValueLabel": false,
        "layout": "rack",
        "cellWidth": 14,
        "nodesPerBlade": 1,
        "bladeOverrides": "cpu[1-4]: 4\nbigmem[1-2]: 3\nvisu1: 1\ngpu[1-2]: 2",
        "slotsPerRack": 20,
        "slotOverrides": "",
        "colorMode": "state",
        "gap": 2,
        "centreRacks": true,
        "showNodeCount": true,
        "cellHeight": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_node_status",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "slurm_node_cpu_alloc",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "slurm_node_cpu_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "slurm_node_gres_used",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "slurm_node_gres_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "slurm_node_drain_reason_info",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "time() - slurm_node_drain_since_timestamp_seconds",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "CPU allocation by partition",
      "description": "One bar per partition rather than one number for the cluster: a floor at 63% can be a bigmem tier at 94% with nowhere left to put a large job, next to a visu tier nobody is using. The single figure hides exactly the thing worth acting on.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (partition) (slurm_node_cpu_alloc{partition=~\"cpu|bigmem|visu|gpu\"}) / sum by (partition) (slurm_node_cpu_total{partition=~\"cpu|bigmem|visu|gpu\"}) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true,
          "legendFormat": "{{partition}}"
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "sizing": "auto",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 22
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 40,
                "color": "orange"
              },
              {
                "value": 60,
                "color": "yellow"
              },
              {
                "value": 80,
                "color": "green"
              }
