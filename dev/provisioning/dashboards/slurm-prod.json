        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"mix.*\",status!~\".*[*~]\"})) or vector(0)",
          "instant": false,
