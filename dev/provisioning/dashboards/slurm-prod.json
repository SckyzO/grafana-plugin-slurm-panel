    {
      "id": 10,
      "type": "tomzone-slurm-panel",
      "title": "Nodes by rack",
      "description": "One cell per node, grouped by the rack label Prometheus relabelling adds at scrape time. Each cabinet is drawn as many sleds wide as its blade holds and twenty slots tall. Hover a node for its state, cores, GPUs and, when drained, the reason and how long it has been out.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "labels": {
          "node": "node",
          "state": "status",
          "partition": "partition",
          "gresType": "gres_type",
          "reason": "reason"
        },
        "queries": {
          "state": "A",
          "cpuAlloc": "B",
          "cpuTotal": "C",
          "gresUsed": "D",
          "gresTotal": "E",
          "drainReason": "F",
          "drainSince": "G"
        },
        "grouping": {
          "kind": "label",
          "label": "rack"
        },
        "layout": "rack",
        "cellWidth": 28,
        "bladeOverrides": "cpu[1-4]: 4\nbigmem[1-2]: 3\nvisu1: 1\ngpu[1-2]: 2",
        "slotsPerRack": 20,
        "centreRacks": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_node_status",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "slurm_node_cpu_alloc",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "slurm_node_cpu_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "slurm_node_gres_used",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "slurm_node_gres_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "slurm_node_drain_reason_info",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "time() - slurm_node_drain_since_timestamp_seconds",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "CPU allocation by partition",
      "description": "CPU allocated over CPU total, per partition.",
      "datasource": {
