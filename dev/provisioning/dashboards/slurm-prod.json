        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Drained",
      "description": "Taken out of service by a human. The reasons are in the table below. A node whose state carries the `*` suffix has stopped answering whatever it was doing, and is left out here because the floor beside it paints that node orange rather than this tile's colour.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 17,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"drain.*|drng.*\",status!~\".*[*~]\"})) or vector(0)",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Down",
      "description": "The only tile allowed to turn red on its own. A node whose state carries the `*` suffix has stopped answering whatever it was doing, and is left out here because the floor beside it paints that node orange rather than this tile's colour.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (node) (slurm_node_status{status=~\"down.*|fail.*|unk.*\",status!~\".*[*~]\"})) or vector(0)",
          "instant": false,
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "CPU allocated",
      "description": "Cores, deduplicated per node the same way the gauge is.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 60
              },
              {
                "color": "yellow",
                "value": 92
              }
            ]
          },
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "sizing": "auto",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (node) (slurm_node_cpu_alloc)) / sum(max by (node) (slurm_node_cpu_total)) * 100",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{gres_type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "GPU allocated, by type",
      "description": "Per GPU type. `gres_type` is the label slurm_exporter attaches to the gres series, and a node with no GPU contributes nothing rather than a zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          },
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "text",
        "namePlacement": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "sizing": "auto",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gres_type) (max by (node, gres_type) (slurm_node_gres_used)) / sum by (gres_type) (max by (node, gres_type) (slurm_node_gres_total)) * 100",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{gres_type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "tomzone-slurm-panel",
      "title": "The floor",
      "description": "Six cabinets against live Prometheus, two nodes to a blade, each declared at twenty-one slots so the floor is flat and every cabinet keeps one free position visible above its contents. The rack label comes from Prometheus relabelling at scrape time -- the first of the three routes to a topology, and the only one that needs no per-dashboard configuration. Hover a node for its state, its cores, its GPUs and, when it is drained, the reason and how long it has been out.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 15,
        "w": 13,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "labels": {
          "node": "node",
          "state": "status",
          "partition": "partition",
          "gresType": "gres_type",
          "reason": "reason"
        },
        "queries": {
          "state": "A",
          "cpuAlloc": "B",
          "cpuTotal": "C",
          "gresUsed": "D",
          "gresTotal": "E",
          "drainReason": "F",
          "drainSince": "G"
        },
        "grouping": {
          "kind": "label",
          "label": "rack"
        },
        "multiValueLabel": false,
        "layout": "rack",
        "cellWidth": 24,
        "nodesPerBlade": 2,
        "bladeOverrides": "",
        "slotsPerRack": 21,
        "slotOverrides": "",
        "shapeChannel": true,
        "colorMode": "state",
        "gap": 2,
        "centreRacks": true,
        "showNodeCount": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_node_status",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "slurm_node_cpu_alloc",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "slurm_node_cpu_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "slurm_node_gres_used",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "slurm_node_gres_total",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "slurm_node_drain_reason_info",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "time() - slurm_node_drain_since_timestamp_seconds",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Why these nodes are out",
      "description": "slurm_node_drain_reason_info carries no partition label, so it cannot be joined to slurm_node_status by any stock panel -- which is the gap this plugin was written to close. Here it is as a table for the record; the same join is in every drained node's tooltip on the floor above.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 15,
        "w": 11,
        "x": 13,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hideFrom.viz",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Out for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reason"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 650
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Node",
              "scope": "series"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 115
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rack",
              "scope": "series"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 125
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        },
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slurm_node_drain_reason_info",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "time() - slurm_node_drain_since_timestamp_seconds",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "Value #A": true,
              "rack 2": true
            },
            "renameByName": {
              "node": "Node",
              "rack 1": "Rack",
              "reason": "Reason",
              "Value #B": "Out for"
            },
            "indexByName": {
              "node": 0,
              "rack 1": 1,
              "reason": 2,
              "Value #B": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Out for",
                "desc": true
              }
            ]
          }
        }
      ]
    }
  ]
}
