{
  "uid": "slurm-prod",
  "title": "Production example",
  "tags": [
    "slurm",
    "production"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "What a production floor looks like on an ordinary day: the number you check first, the states underneath it, the two resources that actually run out, and the floor itself. Every count goes through `count by (node)` before it is counted, because slurm_exporter publishes one series per node and partition and a node in three partitions is still one node.",
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Node availability",
      "description": "Share of nodes a job could land on: everything except drained, draining, down, failed, unknown, invalid, reserved, under maintenance or not answering.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - ((count(count by (node) (slurm_node_status{status=~\"drain.*|drng.*|down.*|fail.*|unk.*|inval.*|maint.*|resv.*|.*[*]\"})) or vector(0)) / (count(count by (node) (slurm_node_status))))) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "slurm-views-prom"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75,
        "sizing": "auto",
        "barShape": "flat",
        "barWidthFactor": 0.6,
        "effects": {
          "barGlow": false,
          "centerGlow": false,
          "gradient": true
        },
        "endpointMarker": "point",
        "orientation": "auto",
        "segmentCount": 1,
        "segmentSpacing": 0.3,
        "shape": "gauge",
        "sparkline": true,
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 85,
                "color": "orange"
              },
              {
                "value": 92,
                "color": "yellow"
              },
              {
                "value": 97,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
