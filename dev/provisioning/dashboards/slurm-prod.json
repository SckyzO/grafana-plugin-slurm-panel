    },
    {
      "id": 4,
      "type": "stat",
      "title": "Idle",
      "description": "Capacity sitting free. Nothing is wrong with it and nothing is earning on it. A node whose state carries the `*` suffix has stopped answering whatever it was doing, and is left out here because the floor beside it paints that node orange rather than this tile's colour.",
      "datasource": {
        "type": "prometheus",
        "uid": "slurm-views-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 14,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
