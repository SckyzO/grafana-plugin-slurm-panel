          "scenarioId": "csv_content",
          "csvContent": "node,partition,status,Value\nn001,cpu,idle,1\nn002,cpu,idle*,1\nn003,cpu,idle~,1\nn004,cpu,idle-,1\nn005,cpu,mix,1\nn006,cpu,mixed,1\nn007,cpu,mixed-,1\nn008,cpu,alloc,1\nn009,cpu,allocated,1\nn010,cpu,allocated+,1\nn011,cpu,allocated-,1\nn012,cpu,drain,1\nn013,cpu,drained,1\nn014,cpu,draining,1\nn015,cpu,drng,1\nn016,cpu,down,1\nn017,cpu,down*,1\nn018,cpu,fail,1\nn019,cpu,failing,1\nn020,cpu,failg,1\nn021,cpu,maint,1\nn022,cpu,planned,1\nn023,cpu,plnd,1\nn024,cpu,completing,1\nn025,cpu,comp,1\nn026,cpu,reserved,1\nn027,cpu,resv,1\nn028,cpu,perfctrs,1\nn029,cpu,npc,1\nn030,cpu,blocked,1\nn031,cpu,block,1\nn032,cpu,unknown,1\nn033,cpu,unk,1\nn034,cpu,inval,1\nn035,cpu,reboot_issued,1\nn036,cpu,reboot_requested,1\nn037,cpu,power_down,1\nn038,cpu,powered_down,1\nn039,cpu,powering_up,1\nn040,cpu,pow_dn,1\nn041,cpu,pow_up,1\nn042,cpu,future,1\nn043,cpu,futr,1\n"
