{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Slurm Node Grid",
  "id": "tomzone-slurm-panel",
  "info": {
    "keywords": ["slurm", "hpc", "cluster", "nodes", "batch scheduler"],
    "description": "One cell per Slurm node, coloured by state, CPU, memory or GPU utilisation, and grouped to match how the cluster is actually organised.",
    "author": {
      "name": "Tomzone"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [{ "name": "sponsorship", "url": "https://github.com/sponsors/SckyzO" }],
    "screenshots": [
      { "name": "A cluster of six racks, coloured by node state", "path": "img/node-grid-by-rack.png" },
      { "name": "Every Slurm state, coloured before anything is configured", "path": "img/node-grid-states.png" },
      { "name": "GPU occupancy: a node with no GPU is drawn empty, not coloured", "path": "img/node-grid-gpu.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "grafanaVersion": "12.3.x",
    "plugins": []
  }
}
